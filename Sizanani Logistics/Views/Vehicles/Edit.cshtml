@model Sizanani_Logistics.Models.Vehicle

<h5>Edit Vehicle</h5>

<form asp-controller="Vehicles" asp-action="Edit" method="post">
    <input asp-for="VehicleId" type="hidden" />
    <div class="mb-3">
        <label asp-for="Type" class="form-label">Vehicle Type</label>
        <input asp-for="Type" class="form-control" />
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Model" class="form-label">Model</label>
        <input asp-for="Model" type="tel" class="form-control" />
        <span asp-validation-for="Model" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Registration" class="form-label">Registration</label>
        <input asp-for="Registration" type="tel" class="form-control" />
        <span asp-validation-for="Registration" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Weight" class="form-label">Weigth (Tons)</label>
        <input asp-for="Weight" type="tel" class="form-control" />
        <span asp-validation-for="Weight" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>