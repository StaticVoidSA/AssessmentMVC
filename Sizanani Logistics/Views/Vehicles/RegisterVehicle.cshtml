@model Sizanani_Logistics.Models.Vehicle

@{
    var contractors = ViewBag.Contractors as SelectList;
    bool noContractors = contractors == null || !contractors.Any();
}

<h3>Register New Vehicle</h3>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<form asp-controller="Vehicles" asp-action="RegisterVehicle" method="post">
    <div class="form-group">
        <label asp-for="Registration"></label>
        <input disabled="@noContractors" asp-for="Registration" class="form-control" />
        <span asp-validation-for="Registration" class="text-danger"></span>
    </div>    

    <div class="form-group">
        <label asp-for="Model"></label>
        <input disabled="@noContractors" asp-for="Model" class="form-control" />
        <span asp-validation-for="Model" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Type"></label>
        <input disabled="@noContractors" asp-for="Type" class="form-control" />
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>
    
    <div class="form-group">
        <label asp-for="Weight"></label>
        <input disabled="@noContractors" asp-for="Weight" class="form-control" />
        <span asp-validation-for="Weight" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <select asp-for="ContractorId" asp-items="ViewBag.contractors" class="form-control">
            <option value="">-- Select a Contractor --</option>
        </select>
    </div>

    @if (@noContractors)
    {
        <div class="mt-3">Please create a contractor first before creating a vehicle (Vehicles must be assigned to contractors)</div>
    }

    <button disabled="@noContractors" type="submit" class="btn btn-primary mt-3">Register</button>
</form>